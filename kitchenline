<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>The Household Kitchen Line™</title>
    <script src="https://jsdelivr.net"></script>
    <style>
        :root {
            --bg-primary: #121212;
            --bg-surface: #1e1e1e;
            --bg-card: #2a2a2a;
            --text-primary: #f5f5f7;
            --text-secondary: #a1a1aa;
            --accent: #d4af37; /* Metallic Gold */
            --accent-hover: #bda030;
            --border: #333333;
            --success: #4ade80;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            -webkit-tap-highlight-color: transparent;
        }

        body {
            background-color: var(--bg-primary);
            color: var(--text-primary);
            padding: 16px;
            max-width: 480px;
            margin: 0 auto;
            padding-bottom: 80px;
        }

        header {
            text-align: center;
            padding: 24px 0;
            border-bottom: 1px solid var(--border);
            margin-bottom: 24px;
        }

        header h1 {
            font-size: 24px;
            font-weight: 800;
            letter-spacing: -0.5px;
            color: var(--text-primary);
        }

        header p {
            color: var(--text-secondary);
            font-size: 13px;
            margin-top: 4px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .section-title {
            font-size: 18px;
            font-weight: 700;
            margin-bottom: 16px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        /* TIMER WIDGET */
        .timer-card {
            background: linear-gradient(145deg, var(--bg-surface), #1a1a1a);
            border: 1px solid var(--border);
            border-radius: 16px;
            padding: 20px;
            text-align: center;
            margin-bottom: 28px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.4);
        }

        .timer-display {
            font-size: 48px;
            font-weight: 800;
            font-variant-numeric: tabular-nums;
            letter-spacing: -1px;
            margin: 12px 0;
            color: var(--text-primary);
        }

        .timer-controls {
            display: flex;
            justify-content: center;
            gap: 12px;
        }

        .btn {
            background-color: var(--bg-card);
            color: var(--text-primary);
            border: 1px solid var(--border);
            padding: 10px 20px;
            border-radius: 30px;
            font-weight: 600;
            font-size: 14px;
            cursor: pointer;
            transition: all 0.2s ease;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .btn-primary {
            background-color: var(--accent);
            color: #000;
            border: none;
        }

        .btn-primary:hover {
            background-color: var(--accent-hover);
        }

        /* SHIFT BOARD (CHORES) */
        .shift-container {
            margin-bottom: 28px;
        }

        .crew-tabs {
            display: flex;
            gap: 8px;
            margin-bottom: 12px;
        }

        .tab-btn {
            flex: 1;
            background-color: var(--bg-surface);
            border: 1px solid var(--border);
            color: var(--text-secondary);
            padding: 10px;
            border-radius: 8px;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
        }

        .tab-btn.active {
            background-color: var(--bg-card);
            color: var(--accent);
            border-color: var(--accent);
        }

        .shift-card {
            background-color: var(--bg-surface);
            border: 1px solid var(--border);
            border-radius: 16px;
            padding: 16px;
            display: none;
        }

        .shift-card.active {
            display: block;
        }

        .chore-item {
            display: flex;
            align-items: flex-start;
            gap: 12px;
            padding: 14px 0;
            border-bottom: 1px solid var(--border);
            cursor: pointer;
        }

        .chore-item:last-child {
            border-bottom: none;
        }

        .chore-checkbox {
            width: 22px;
            height: 22px;
            border: 2px solid var(--text-secondary);
            border-radius: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            margin-top: 1px;
            transition: all 0.2s;
        }

        .chore-item.completed .chore-checkbox {
            background-color: var(--success);
            border-color: var(--success);
        }

        .chore-checkbox svg {
            display: none;
            width: 14px;
            height: 14px;
            color: #000;
        }

        .chore-item.completed .chore-checkbox svg {
            display: block;
        }

        .chore-text h4 {
            font-size: 15px;
            font-weight: 600;
            transition: color 0.2s;
        }

        .chore-text p {
            font-size: 12px;
            color: var(--text-secondary);
            margin-top: 2px;
        }

        .chore-item.completed .chore-text h4 {
            text-decoration: line-through;
            color: var(--text-secondary);
        }

        /* RECIPE MATRIX SYSTEM */
        .recipe-section {
            margin-bottom: 28px;
        }

        .recipe-select {
            width: 100%;
            background-color: var(--bg-surface);
            color: var(--text-primary);
            border: 1px solid var(--border);
            padding: 14px;
            border-radius: 12px;
            font-size: 15px;
            font-weight: 600;
            outline: none;
            margin-bottom: 16px;
            appearance: none;
            background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://w3.org' width='24' height='24' viewBox='0 0 24 24' fill='none' stroke='%23a1a1aa' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><polyline points='6 9 12 15 18 9'></polyline></svg>");
            background-repeat: no-repeat;
            background-position: right 14px center;
            background-size: 16px;
        }

        .matrix-display {
            background-color: var(--bg-surface);
            border: 1px solid var(--border);
            border-radius: 16px;
            padding: 16px;
        }

        .matrix-tier {
            margin-bottom: 16px;
            padding-bottom: 16px;
            border-bottom: 1px solid var(--border);
        }

        .matrix-tier:last-child {
            margin-bottom: 0;
            padding-bottom: 0;
            border-bottom: none;
        }

        .tier-header {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 13px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 6px;
        }

        .tier-teen { color: #ff453a; }
        .tier-preteen { color: #ff9f0a; }
        .tier-toddler { color: #64d2ff; }

        .tier-content {
            font-size: 14px;
            line-height: 1.4;
            color: var(--text-primary);
        }

        .footer-branding {
            text-align: center;
            font-size: 12px;
            color: var(--text-secondary);
            margin-top: 40px;
        }
    </style>
</head>
<body>

    <header>
        <h1>THE HOUSEHOLD KITCHEN LINE™</h1>
        <p>Home Dispatch & Operations</p>
    </header>

    <!-- SHIFT TIMER WIDGET -->
    <div class="timer-card">
        <div class="section-title" style="justify-content: center; margin-bottom: 0;">
            <i data-lucide="timer" style="color: var(--accent); width: 18px; height: 18px;"></i>
            <span>Active Shift Timer</span>
        </div>
        <div class="timer-display" id="timer-display">15:00</div>
        <div class="timer-controls">
            <button class="btn btn-primary" id="timer-start" onclick="toggleTimer()">
                <i data-lucide="play" id="timer-icon" style="width: 16px; height: 16px;"></i>
                <span id="timer-text">Start Shift</span>
            </button>
            <button class="btn" onclick="resetTimer()">Reset</button>
        </div>
    </div>

    <!-- SHIFT BOARD (CHORES) -->
    <div class="shift-container">
        <div class="section-title">
            <i data-lucide="clipboard-list" style="color: var(--accent); width: 20px; height: 20px;"></i>
            <span>Crew Shift Assignments</span>
        </div>
        <div class="crew-tabs">
            <button class="tab-btn active" onclick="switchCrew('teen')">Teenager</button>
            <button class="tab-btn" onclick="switchCrew('preteen')">Pre-Teen (8yo)</button>
            <button class="tab-btn" onclick="switchCrew('toddler')">Toddler</button>
        </div>

        <!-- TEEN SHIFT -->
        <div class="shift-card active" id="crew-teen">
            <div class="chore-item" onclick="toggleChore(this)">
                <div class="chore-checkbox"><i data-lucide="check"></i></div>
                <div class="chore-text">
                    <h4>Gather Room Laundry & Trash</h4>
                    <p>Strip personal zone clean and bag all waste contents.</p>
                </div>
            </div>
            <div class="chore-item" onclick="toggleChore(this)">
                <div class="chore-checkbox"><i data-lucide="check"></i></div>
                <div class="chore-text">
